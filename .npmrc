# npm 包镜像（npm 官方 registry 亦可，按网络情况选择）
registry=https://registry.npmmirror.com

# 以下两项是 electron-builder 的私有配置（用于下载 Electron 与构建二进制），
# 不是 npm 标准配置，因此 npm 会对它们提示"未知项目配置"；属正常现象，请勿删除。
# 由于 npmmirror 不提供 audit 端点，npm audit 会返回 404，不能据此判断依赖安全性。
# 如需审计请改用官方源：npm audit --registry=https://registry.npmjs.org
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/